# Digital Sanctuary — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or real keys.

# --- Supabase (account: "Supabase 2", org: Mad82-ops) ---
# Found in Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key for privileged operations (e.g. guest→account merge Edge Function).
# Keep this secret. Set it in Vercel project settings, not in the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
